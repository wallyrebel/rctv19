---
layout: layouts/base.njk
title: Ripley and Tippah County News Archive
description: Every story RCTV19 has published about Ripley and Tippah County, Mississippi — high school sports, local business, community events, schools and downtown Ripley.
pagination:
  data: collections.posts
  size: 12
  alias: posts
permalink: "blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<div class="container">
  <!-- Top Banner Ad -->
  <div class="top-ad-wrapper">
    {% set slotName = "topBanner" %}
    {% set format = "banner" %}
    {% include "components/ad-slot.njk" %}
  </div>

  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">›</span>
    <span aria-current="page">News</span>
  </nav>

  <header class="page-header">
    <h1 class="page-title">Ripley and Tippah County News</h1>
    <p class="page-subtitle">Every story from RCTV19, newest first{% if pagination.pageNumber > 0 %} — page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}{% endif %}</p>
  </header>

  {% if pagination.pageNumber == 0 %}
  <nav class="topic-chips" aria-label="Browse by topic">
    <span class="topic-chips-label">Browse by topic:</span>
    {% for topic in collections.topicPages %}<a class="topic-tag" href="{{ topic.url }}">{{ topic.name }}</a>{% endfor %}
  </nav>
  {% endif %}

  <div class="blog-grid">
    {% for post in posts %}
      {% include "components/post-card.njk" %}
    {% endfor %}
  </div>
  
  <!-- Pagination -->
  {% if pagination.pages.length > 1 %}
  <nav class="pagination" aria-label="Blog pagination">
    {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}" class="pagination-link">
      ← Previous
    </a>
    {% endif %}
    
    <span class="pagination-current">
      Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}
    </span>
    
    {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}" class="pagination-link">
      Next →
    </a>
    {% endif %}
  </nav>
  {% endif %}
</div>
