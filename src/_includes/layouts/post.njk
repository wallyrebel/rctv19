---
layout: layouts/base.njk
---
<!-- NewsArticle Structured Data for SEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org", "@type": "NewsArticle",
  "headline": {{ title | jsonLd | safe }},
  "description": {{ (excerpt or (content | excerpt)) | jsonLd | safe }},
  "image": {{ (site.url + (featuredImage or '/assets/img/rctv19-logo.jpg')) | jsonLd | safe }},
  "datePublished": {{ (date | dateISO) | jsonLd | safe }},
  "dateModified": {{ ((updated or date) | dateISO) | jsonLd | safe }},
  "author": {"@type": "Organization", "name": {{ site.author | jsonLd | safe }}, "url": {{ (site.url + '/about/') | jsonLd | safe }}},
  "publisher": {"@type": "Organization", "name": {{ site.title | jsonLd | safe }}, "logo": {"@type": "ImageObject", "url": {{ (site.url + '/assets/img/rctv19-logo.jpg') | jsonLd | safe }}}},
  "mainEntityOfPage": {"@type": "WebPage", "@id": {{ (site.url + page.url) | jsonLd | safe }}},
  "isAccessibleForFree": true
}
</script>

<!-- Top Banner Ad -->
<div class="container top-ad-wrapper">
  {% set slotName = "topBanner" %}
  {% set format = "banner" %}
  {% include "components/ad-slot.njk" %}
</div>

<article class="container" itemscope itemtype="https://schema.org/NewsArticle">
  <header class="post-header">
    <div class="post-meta">
      <time datetime="{{ date | dateISO }}" itemprop="datePublished">{{ date | dateDisplay }}</time>
    </div>
    <p>By <a href="/about/">{{ site.author }}</a></p>
    <h1 class="post-title" itemprop="headline">{{ title }}</h1>
  </header>
  
  {% if featuredImage %}
  <div class="post-featured-image">
    <img 
      src="{{ featuredImage | optimizedImage(960) }}"
      srcset="{{ featuredImage | optimizedImage(480) }} 480w, {{ featuredImage | optimizedImage(960) }} 960w"
      sizes="(max-width: 960px) 100vw, 900px"
      alt="{{ title }}"
      loading="eager"
      fetchpriority="high"
      width="900"
      height="506"
    >
  </div>
  {% endif %}
  
  <div class="post-content">
    {{ content | articleBody | safe }}
  </div>
  
  {% if sourceUrl %}<p class="post-content">Source: <a href="{{ sourceUrl }}" rel="noopener">{{ sourceName or 'Original report' }}</a>{% if aiAssisted %}. Prepared with AI assistance.{% endif %}</p>{% endif %}
  <p class="post-content"><a href="/editorial/">Our editorial standards</a> · <a href="mailto:rctv19@gmail.com?subject=Article%20correction">Report a correction</a></p>
  <!-- In-Feed Ad -->
  <div class="in-feed-ad-wrapper">
    {% set slotName = "inFeed" %}
    {% set format = "rectangle" %}
    {% include "components/ad-slot.njk" %}
  </div>
  
  {% include "components/share-links.njk" %}
  
  <!-- Related Posts -->
  {% set relatedPosts = collections.posts | shuffle | limit(3) %}
  {% if relatedPosts.length > 0 %}
  <section class="related-posts">
    <div class="section-header">
      <h2 class="section-title">Related Stories</h2>
    </div>
    <div class="related-posts-grid">
      {% for post in relatedPosts %}
        {% if post.url != page.url %}
          {% include "components/post-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endif %}
</article>
