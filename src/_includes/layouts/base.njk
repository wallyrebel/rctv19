<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  {# Verification is separate from ad serving; configure the CMP before enabling ads. #}
  {% if ads.adsensePublisherId | validPublisher %}
  <meta name="google-adsense-account" content="{{ ads.adsensePublisherId }}">
  {% endif %}
  {% if ads.adsenseEnabled and adsEligible and not noindex and (ads.adsensePublisherId | validPublisher) %}
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ ads.adsensePublisherId }}" crossorigin="anonymous"></script>
  {% endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="google-site-verification" content="OtgNopRtAndg_iiDcxpnWoSaCMtW6rdO0U01BnAIYEw" />
  
  <title>{% if title %}{{ title }}{% if pagination.pageNumber > 0 %} — Page {{ pagination.pageNumber + 1 }}{% endif %} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or excerpt or site.description }}">
  
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  
  <!-- Open Graph -->
  <meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or excerpt or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  {% if featuredImage %}
  <meta property="og:image" content="{{ site.url }}{{ featuredImage }}">
  {% else %}
  <meta property="og:image" content="{{ site.url }}/assets/img/rctv19-logo.jpg">
  {% endif %}
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or excerpt or site.description }}">
  {% if featuredImage %}
  <meta name="twitter:image" content="{{ site.url }}{{ featuredImage }}">
  {% endif %}
  
  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS Feed" href="{{ site.url }}/feed.xml">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/assets/img/watch-live-icon.png">
  
  <!-- Styles -->
  <link rel="stylesheet" href="/assets/css/main.css?v=7">
  
  <!-- Structured Data: Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ site.title | jsonLd | safe }},
    "alternateName": "RCTV19",
    "url": {{ site.url | jsonLd | safe }},
    "logo": {{ (site.url + "/assets/img/rctv19-logo.jpg") | jsonLd | safe }},
    "description": {{ site.description | jsonLd | safe }},
    "sameAs": [
      {{ site.social.facebook | jsonLd | safe }},
      {{ site.social.twitter | jsonLd | safe }}
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "url": {{ (site.url + "/contact/") | jsonLd | safe }}
    }
  }
  </script>
  
  <!-- Structured Data: WebSite with SearchAction -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ site.title | jsonLd | safe }},
    "url": {{ site.url | jsonLd | safe }},
    "publisher": {
      "@type": "Organization",
      "name": {{ site.title | jsonLd | safe }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ (site.url + "/assets/img/rctv19-logo.jpg") | jsonLd | safe }}
      }
    }
  }
  </script>
  
  <!-- Structured Data: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ site.url | jsonLd | safe }}
      }
      {% if page.url != "/" %},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ title | jsonLd | safe }},
        "item": {{ (site.url + page.url) | jsonLd | safe }}
      }
      {% endif %}
    ]
  }
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  
  {% include "components/header.njk" %}
  
  <main id="main-content" class="site-main">
    {{ content | safe }}
  </main>
  
  {% include "components/footer.njk" %}
  
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
